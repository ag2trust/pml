{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pml.dev/schema/0.1/pml.schema.json",
  "title": "Product Manifest Language 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["pml", "project", "domains"],
  "properties": {
    "pml": {"const": "0.1-draft"},
    "project": {"$ref": "#/$defs/project"},
    "vocabulary": {"$ref": "#/$defs/vocabularyMap"},
    "actors": {"$ref": "#/$defs/actorMap"},
    "concepts": {"$ref": "#/$defs/conceptMap"},
    "signals": {"$ref": "#/$defs/signalMap"},
    "rules": {"$ref": "#/$defs/ruleMap"},
    "architecture": {"$ref": "#/$defs/architectureMap"},
    "domains": {"$ref": "#/$defs/domainMap"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmpty"}
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "pathList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^domains\\.[a-z][a-z0-9_]*\\.features\\.[a-z][a-z0-9_]*(?:\\.components\\.[a-z][a-z0-9_]*)?$"
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "purpose"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/nonEmpty"},
        "purpose": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "vocabularyMap": {
      "type": "object",
      "maxProperties": 25,
      "additionalProperties": {"$ref": "#/$defs/vocabulary"}
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meaning"],
      "properties": {
        "meaning": {"$ref": "#/$defs/nonEmpty"},
        "forbidden_synonyms": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmpty"}
        }
      }
    },
    "actorMap": {
      "type": "object",
      "maxProperties": 25,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/actor"}
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meaning"],
      "properties": {
        "meaning": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "conceptMap": {
      "type": "object",
      "maxProperties": 25,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/concept"}
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meaning"],
      "properties": {
        "meaning": {"$ref": "#/$defs/nonEmpty"},
        "states": {"$ref": "#/$defs/stringList"}
      }
    },
    "signalMap": {
      "type": "object",
      "maxProperties": 25,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/signal"}
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meaning"],
      "properties": {
        "meaning": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "ruleMap": {
      "type": "object",
      "maxProperties": 7,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/rule"}
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {
        "statement": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "architectureMap": {
      "type": "object",
      "maxProperties": 25,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/architectureDecision"}
    },
    "architectureDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "selection", "rationale"],
      "properties": {
        "category": {
          "enum": [
            "database",
            "framework",
            "gateway",
            "provider",
            "payment_processor",
            "runtime"
          ]
        },
        "selection": {"$ref": "#/$defs/nonEmpty"},
        "rationale": {"$ref": "#/$defs/nonEmpty"},
        "constraints": {"$ref": "#/$defs/ruleMap"}
      }
    },
    "domainMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 25,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/domain"}
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "features"],
      "properties": {
        "purpose": {"$ref": "#/$defs/nonEmpty"},
        "rules": {"$ref": "#/$defs/ruleMap"},
        "features": {"$ref": "#/$defs/featureMap"}
      }
    },
    "featureMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 25,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/feature"}
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose"],
      "anyOf": [
        {"required": ["rules"]},
        {"required": ["use_cases"]},
        {"required": ["components"]}
      ],
      "properties": {
        "purpose": {"$ref": "#/$defs/nonEmpty"},
        "actors": {"$ref": "#/$defs/idList"},
        "rules": {"$ref": "#/$defs/ruleMap"},
        "use_cases": {"$ref": "#/$defs/useCaseMap"},
        "components": {"$ref": "#/$defs/componentMap"},
        "experience": {"$ref": "#/$defs/experience"},
        "reactions": {"$ref": "#/$defs/reactionMap"},
        "related_to": {"$ref": "#/$defs/pathList"},
        "emits": {"$ref": "#/$defs/idList"},
        "architecture": {"$ref": "#/$defs/idList"}
      }
    },
    "componentMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 25,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/component"}
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose"],
      "properties": {
        "purpose": {"$ref": "#/$defs/nonEmpty"},
        "inputs": {"$ref": "#/$defs/stringList"},
        "outputs": {"$ref": "#/$defs/stringList"},
        "rules": {"$ref": "#/$defs/ruleMap"},
        "reactions": {"$ref": "#/$defs/reactionMap"},
        "related_to": {"$ref": "#/$defs/pathList"},
        "emits": {"$ref": "#/$defs/idList"},
        "architecture": {"$ref": "#/$defs/idList"}
      }
    },
    "useCaseMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 25,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/useCase"}
    },
    "useCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "goal", "given", "when", "then"],
      "properties": {
        "actor": {"$ref": "#/$defs/id"},
        "goal": {"$ref": "#/$defs/nonEmpty"},
        "given": {"$ref": "#/$defs/stringList"},
        "when": {"$ref": "#/$defs/stringList"},
        "then": {"$ref": "#/$defs/stringList"},
        "otherwise": {"$ref": "#/$defs/stringList"}
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaces"],
      "properties": {
        "surfaces": {
          "type": "object",
          "maxProperties": 25,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/surface"}
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains"],
      "properties": {
        "contains": {"$ref": "#/$defs/stringList"},
        "states": {
          "type": "object",
          "maxProperties": 25,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/stringList"}
        },
        "accessibility": {"$ref": "#/$defs/stringList"},
        "responsive_behavior": {"$ref": "#/$defs/stringList"}
      }
    },
    "reactionMap": {
      "type": "object",
      "maxProperties": 25,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/reaction"}
    },
    "reaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on", "statement"],
      "properties": {
        "on": {"$ref": "#/$defs/id"},
        "statement": {"$ref": "#/$defs/nonEmpty"}
      }
    }
  }
}
