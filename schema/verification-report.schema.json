{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PML verification report",
  "type": "object",
  "additionalProperties": false,
  "required": ["verification", "version", "environment", "verifier", "targets", "verdict", "checks", "limitations"],
  "properties": {
    "verification": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "environment": {"enum": ["isolated", "local_integrated", "staging", "production"]},
    "verifier": {
      "type": "object", "additionalProperties": false, "required": ["agent", "provider", "model", "effort"],
      "properties": {"agent": {"type": "string"}, "provider": {"type": "string"}, "model": {"type": "string"}, "effort": {"enum": ["low", "medium", "high"]}}
    },
    "targets": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "verdict": {"enum": ["verified", "failed", "incomplete", "blocked"]},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["target", "result", "observation"],
        "properties": {"target": {"type": "string"}, "result": {"enum": ["passed", "failed", "not_evaluated", "blocked"]}, "observation": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}

