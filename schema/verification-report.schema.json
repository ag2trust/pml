{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PML verification report",
  "type": "object",
  "additionalProperties": false,
  "required": ["verification", "version", "recorded", "environment", "verifier", "targets", "verdict", "checks", "limitations"],
  "properties": {
    "verification": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "recorded": {"type": "string", "format": "date-time"},
    "environment": {"enum": ["isolated", "local_integrated", "staging", "production"]},
    "verifier": {
      "type": "object", "additionalProperties": false, "required": ["agent", "provider", "model", "effort"],
      "properties": {"agent": {"type": "string"}, "provider": {"type": "string"}, "model": {"type": "string"}, "effort": {"enum": ["low", "medium", "high"]}}
    },
    "targets": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "verdict": {"enum": ["verified", "failed", "incomplete", "blocked"]},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["target", "result", "method", "observation"],
        "properties": {"target": {"type": "string"}, "result": {"enum": ["passed", "failed", "not_evaluated", "blocked"]}, "method": {"enum": ["deterministic_probe", "human_attestation", "agent_judgment"]}, "probe": {"type": "string"}, "attester": {"type": "string", "minLength": 1}, "reproduction": {"type": "array", "items": {"type": "string"}}, "observation": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}}},
        "if": {"properties": {"method": {"const": "agent_judgment"}, "result": {"const": "passed"}}, "required": ["method", "result"]},
        "then": {"required": ["reproduction"]},
        "allOf": [
          {"if": {"properties": {"method": {"const": "deterministic_probe"}}, "required": ["method"]}, "then": {"required": ["probe"]}},
          {"if": {"properties": {"method": {"const": "human_attestation"}}, "required": ["method"]}, "then": {"required": ["attester"]}}
        ]
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
