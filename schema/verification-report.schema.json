{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PML verification report",
  "type": "object",
  "additionalProperties": false,
  "required": ["verification", "version", "recorded", "environment", "verifier", "targets", "verdict", "limitations"],
  "properties": {
    "verification": {"type": "string", "minLength": 1, "maxLength": 4096},
    "version": {"type": "string", "minLength": 1, "maxLength": 4096},
    "recorded": {"type": "string", "format": "date-time", "maxLength": 4096},
    "environment": {"enum": ["isolated", "local_integrated", "staging", "production"]},
    "verifier": {
      "type": "object", "additionalProperties": false, "required": ["agent", "provider", "model", "effort"],
      "properties": {"agent": {"type": "string", "minLength": 1, "maxLength": 4096}, "provider": {"type": "string", "minLength": 1, "maxLength": 4096}, "model": {"type": "string", "minLength": 1, "maxLength": 4096}, "effort": {"enum": ["low", "medium", "high"]}}
    },
    "targets": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096}, "uniqueItems": true},
    "verdict": {"enum": ["verified", "failed", "incomplete", "blocked"]},
    "implementation": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["target", "status", "observation"],
        "properties": {"target": {"type": "string", "minLength": 1, "maxLength": 4096}, "status": {"enum": ["implemented", "partial", "missing", "unknown"]}, "observation": {"type": "string", "minLength": 1, "maxLength": 4096}}
      }
    },
    "checks": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["target", "result", "method", "observation"],
        "properties": {"target": {"type": "string", "minLength": 1, "maxLength": 4096}, "result": {"enum": ["passed", "failed", "not_evaluated", "blocked"]}, "method": {"enum": ["deterministic_probe", "human_attestation", "agent_judgment"]}, "probe": {"type": "string", "minLength": 1, "maxLength": 4096}, "attester": {"type": "string", "minLength": 1, "maxLength": 4096}, "reproduction": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}, "observation": {"type": "string", "minLength": 1, "maxLength": 4096}, "evidence": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096}, "uniqueItems": true}},
        "if": {"properties": {"method": {"const": "agent_judgment"}}, "required": ["method"]},
        "then": {"required": ["reproduction"]},
        "allOf": [
          {"if": {"properties": {"method": {"const": "deterministic_probe"}}, "required": ["method"]}, "then": {"required": ["probe"]}},
          {"if": {"properties": {"method": {"const": "human_attestation"}}, "required": ["method"]}, "then": {"required": ["attester"]}}
        ]
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
  },
  "anyOf": [
    {"required": ["implementation"]},
    {"required": ["checks"]}
  ]
}
