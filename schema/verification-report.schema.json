{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PML verification report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification",
    "version",
    "recorded",
    "environment",
    "verifier",
    "targets",
    "verdict",
    "limitations"
  ],
  "properties": {
    "verification": {"$ref": "#/$defs/identifier"},
    "version": {"$ref": "#/$defs/text"},
    "recorded": {"$ref": "#/$defs/recordedTime"},
    "environment": {
      "enum": ["isolated", "local_integrated", "staging", "production"]
    },
    "verifier": {"$ref": "#/$defs/verifier"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/text"},
      "uniqueItems": true
    },
    "verdict": {"enum": ["verified", "failed", "incomplete", "blocked"]},
    "implementation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/implementationAssessment"}
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/deterministicCheck"},
          {"$ref": "#/$defs/agentJudgmentCheck"},
          {"$ref": "#/$defs/humanAttestationCheck"}
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {"$ref": "#/$defs/text"}
    }
  },
  "anyOf": [
    {"required": ["implementation"]},
    {"required": ["checks"]}
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "recordedTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "provider", "model", "effort"],
      "properties": {
        "agent": {"$ref": "#/$defs/text"},
        "provider": {"$ref": "#/$defs/text"},
        "model": {"$ref": "#/$defs/text"},
        "effort": {"enum": ["low", "medium", "high"]}
      }
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "result": {"enum": ["passed", "failed", "not_evaluated", "blocked"]},
    "implementationAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "status", "observation"],
      "properties": {
        "target": {"$ref": "#/$defs/target"},
        "status": {"enum": ["implemented", "partial", "missing", "unknown"]},
        "observation": {"$ref": "#/$defs/text"}
      }
    },
    "deterministicCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "result", "method", "probe", "observation"],
      "properties": {
        "target": {"$ref": "#/$defs/target"},
        "result": {"$ref": "#/$defs/result"},
        "method": {"const": "deterministic_probe"},
        "probe": {"$ref": "#/$defs/identifier"},
        "observation": {"$ref": "#/$defs/text"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/text"},
          "uniqueItems": true
        }
      }
    },
    "agentJudgmentCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "result",
        "method",
        "reproduction",
        "observation"
      ],
      "properties": {
        "target": {"$ref": "#/$defs/target"},
        "result": {"$ref": "#/$defs/result"},
        "method": {"const": "agent_judgment"},
        "reproduction": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/text"}
        },
        "observation": {"$ref": "#/$defs/text"}
      }
    },
    "humanAttestationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "result", "method", "attester", "observation"],
      "properties": {
        "target": {"$ref": "#/$defs/target"},
        "result": {"$ref": "#/$defs/result"},
        "method": {"const": "human_attestation"},
        "attester": {"$ref": "#/$defs/text"},
        "observation": {"$ref": "#/$defs/text"}
      }
    }
  }
}
