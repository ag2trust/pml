{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pml.dev/schema/0.1/pml-state.schema.json",
  "title": "PML product node state 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pml_state",
    "node",
    "definition_hash",
    "bindings_digest",
    "input_fingerprint",
    "obligations"
  ],
  "properties": {
    "pml_state": {"const": "0.1"},
    "node": {"type": "string", "minLength": 1},
    "definition_hash": {"$ref": "#/$defs/hash"},
    "bindings_digest": {"$ref": "#/$defs/hash"},
    "input_fingerprint": {"$ref": "#/$defs/hash"},
    "related_fingerprints": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "obligations": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/obligationState"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "result": {"enum": ["passed", "failed", "not_evaluated", "blocked"]},
    "recordedTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "reportVerifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "provider", "model", "effort"],
      "properties": {
        "agent": {"$ref": "#/$defs/text"},
        "provider": {"$ref": "#/$defs/text"},
        "model": {"$ref": "#/$defs/text"},
        "effort": {"enum": ["low", "medium", "high"]}
      }
    },
    "obligationState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implemented", "evidence"],
      "properties": {
        "implemented": {"enum": ["implemented", "partial", "missing", "unknown"]},
        "implementation": {"$ref": "#/$defs/implementationRecord"},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deterministic_probe": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/probeEvidence"}
            },
            "agent_judgment": {"$ref": "#/$defs/agentEvidence"},
            "human_attestation": {"$ref": "#/$defs/humanEvidence"}
          }
        }
      }
    },
    "implementationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "observation",
        "report_id",
        "report_digest",
        "recorded",
        "verifier"
      ],
      "properties": {
        "status": {"enum": ["implemented", "partial", "missing", "unknown"]},
        "observation": {"$ref": "#/$defs/text"},
        "report_id": {"$ref": "#/$defs/identifier"},
        "report_digest": {"$ref": "#/$defs/hash"},
        "recorded": {"$ref": "#/$defs/recordedTime"},
        "verifier": {"$ref": "#/$defs/reportVerifier"}
      }
    },
    "probeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "input_fingerprint",
        "recorded",
        "observation",
        "report_id",
        "report_digest",
        "verifier",
        "probe",
        "probe_fingerprint"
      ],
      "properties": {
        "result": {"$ref": "#/$defs/result"},
        "input_fingerprint": {"$ref": "#/$defs/hash"},
        "recorded": {"$ref": "#/$defs/recordedTime"},
        "observation": {"$ref": "#/$defs/text"},
        "report_id": {"$ref": "#/$defs/identifier"},
        "report_digest": {"$ref": "#/$defs/hash"},
        "verifier": {"$ref": "#/$defs/reportVerifier"},
        "probe": {"$ref": "#/$defs/identifier"},
        "probe_fingerprint": {"$ref": "#/$defs/hash"},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/text"},
          "uniqueItems": true
        }
      }
    },
    "agentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "input_fingerprint",
        "recorded",
        "observation",
        "report_id",
        "report_digest",
        "verifier",
        "reproduction"
      ],
      "properties": {
        "result": {"$ref": "#/$defs/result"},
        "input_fingerprint": {"$ref": "#/$defs/hash"},
        "recorded": {"$ref": "#/$defs/recordedTime"},
        "observation": {"$ref": "#/$defs/text"},
        "report_id": {"$ref": "#/$defs/identifier"},
        "report_digest": {"$ref": "#/$defs/hash"},
        "verifier": {"$ref": "#/$defs/reportVerifier"},
        "reproduction": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/text"}
        }
      }
    },
    "humanEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "input_fingerprint",
        "recorded",
        "observation",
        "report_id",
        "report_digest",
        "verifier",
        "attester"
      ],
      "properties": {
        "result": {"$ref": "#/$defs/result"},
        "input_fingerprint": {"$ref": "#/$defs/hash"},
        "recorded": {"$ref": "#/$defs/recordedTime"},
        "observation": {"$ref": "#/$defs/text"},
        "report_id": {"$ref": "#/$defs/identifier"},
        "report_digest": {"$ref": "#/$defs/hash"},
        "verifier": {"$ref": "#/$defs/reportVerifier"},
        "attester": {"$ref": "#/$defs/text"}
      }
    }
  }
}
