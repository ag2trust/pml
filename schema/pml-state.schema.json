{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pml.dev/schema/0.1/pml-state.schema.json",
  "title": "PML product node state 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["pml_state", "node", "definition_hash", "input_fingerprint", "obligations"],
  "properties": {
    "pml_state": {"const": "0.1"},
    "node": {"type": "string", "minLength": 1},
    "definition_hash": {"$ref": "#/$defs/hash"},
    "input_fingerprint": {"$ref": "#/$defs/hash"},
    "related_fingerprints": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "obligations": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/obligationState"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "result": {"enum": ["passed", "failed", "not_evaluated", "blocked"]},
    "recorded": {"type": "string", "format": "date-time"},
    "obligationState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implemented", "evidence"],
      "properties": {
        "implemented": {"enum": ["implemented", "partial", "missing", "unknown"]},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deterministic_probe": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/probeEvidence"}
            },
            "agent_judgment": {"$ref": "#/$defs/agentEvidence"},
            "human_attestation": {"$ref": "#/$defs/humanEvidence"}
          }
        }
      }
    },
    "commonEvidence": {
      "type": "object",
      "required": ["result", "input_fingerprint", "recorded", "observation"],
      "properties": {
        "result": {"$ref": "#/$defs/result"},
        "input_fingerprint": {"$ref": "#/$defs/hash"},
        "recorded": {"$ref": "#/$defs/recorded"},
        "observation": {"type": "string", "minLength": 1}
      }
    },
    "probeEvidence": {
      "allOf": [
        {"$ref": "#/$defs/commonEvidence"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "input_fingerprint", "recorded", "observation", "probe_fingerprint"],
          "properties": {
            "result": {"$ref": "#/$defs/result"},
            "input_fingerprint": {"$ref": "#/$defs/hash"},
            "recorded": {"$ref": "#/$defs/recorded"},
            "observation": {"type": "string", "minLength": 1},
            "probe_fingerprint": {"$ref": "#/$defs/hash"},
            "artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          }
        }
      ]
    },
    "agentEvidence": {
      "allOf": [
        {"$ref": "#/$defs/commonEvidence"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "input_fingerprint", "recorded", "observation", "reproduction"],
          "properties": {
            "result": {"$ref": "#/$defs/result"},
            "input_fingerprint": {"$ref": "#/$defs/hash"},
            "recorded": {"$ref": "#/$defs/recorded"},
            "observation": {"type": "string", "minLength": 1},
            "reproduction": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    },
    "humanEvidence": {
      "allOf": [
        {"$ref": "#/$defs/commonEvidence"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "input_fingerprint", "recorded", "observation", "attester"],
          "properties": {
            "result": {"$ref": "#/$defs/result"},
            "input_fingerprint": {"$ref": "#/$defs/hash"},
            "recorded": {"$ref": "#/$defs/recorded"},
            "observation": {"type": "string", "minLength": 1},
            "attester": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
