{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pml.dev/schema/0.1/pml-lock.schema.json",
  "title": "PML definition lock 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["pml_lock", "definition"],
  "properties": {
    "pml_lock": {"const": "0.1"},
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "revision", "digest"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
