{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pml.dev/schema/compiled/1/pml-compiled-model.schema.json",
  "title": "PML compiled semantic model version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "language_version", "definition_digest", "project", "vocabulary", "actors", "concepts", "architecture", "domains", "features", "behaviors", "use_cases", "signals", "relationships", "use_case_memberships", "obligations"],
  "properties": {
    "format": {"const": "pml.compiled"},
    "format_version": {"const": 1},
    "language_version": {"const": "0.1-draft"},
    "definition_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "project": {"$ref": "#/$defs/project"},
    "vocabulary": {"type": "array", "maxItems": 25, "uniqueItems": true, "items": {"$ref": "#/$defs/vocabulary"}},
    "actors": {"type": "array", "maxItems": 25, "uniqueItems": true, "items": {"$ref": "#/$defs/actor"}},
    "concepts": {"type": "array", "maxItems": 25, "uniqueItems": true, "items": {"$ref": "#/$defs/concept"}},
    "architecture": {"type": "array", "maxItems": 25, "uniqueItems": true, "items": {"$ref": "#/$defs/architecture"}},
    "domains": {"type": "array", "minItems": 1, "maxItems": 25, "uniqueItems": true, "items": {"$ref": "#/$defs/domain"}},
    "features": {"type": "array", "minItems": 1, "maxItems": 625, "uniqueItems": true, "items": {"$ref": "#/$defs/feature"}},
    "behaviors": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/behavior"}},
    "use_cases": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/useCase"}},
    "signals": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/signal"}},
    "relationships": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relationship"}},
    "use_case_memberships": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/useCaseMembership"}},
    "obligations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/obligation"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "vocabularyTerm": {"type": "string"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "path": {"type": "string"},
    "domainPath": {"type": "string", "pattern": "^domains\\.[a-z][a-z0-9_]*$"},
    "featurePath": {"type": "string", "pattern": "^domains\\.[a-z][a-z0-9_]*\\.features\\.[a-z][a-z0-9_]*$"},
    "behaviorPath": {"type": "string", "pattern": "^domains\\.[a-z][a-z0-9_]*\\.features\\.[a-z][a-z0-9_]*\\.behaviors\\.[a-z][a-z0-9_]*$"},
    "useCasePath": {"type": "string", "pattern": "^domains\\.[a-z][a-z0-9_]*\\.features\\.[a-z][a-z0-9_]*\\.use_cases\\.[a-z][a-z0-9_]*$"},
    "architecturePath": {"type": "string", "pattern": "^architecture\\.[a-z][a-z0-9_]*$"},
    "productPath": {"type": "string", "pattern": "^domains\\.[a-z][a-z0-9_]*\\.features\\.[a-z][a-z0-9_]*(?:\\.behaviors\\.[a-z][a-z0-9_]*)?$"},
    "obligationNode": {"type": "string", "pattern": "^(?:project|domains\\.[a-z][a-z0-9_]*(?:\\.features\\.[a-z][a-z0-9_]*(?:\\.behaviors\\.[a-z][a-z0-9_]*)?)?|architecture\\.[a-z][a-z0-9_]*)$"},
    "obligationPath": {"type": "string", "pattern": "^(?:project(?:\\.rules\\.[a-z][a-z0-9_]*)?|domains\\.[a-z][a-z0-9_]*(?:\\.rules\\.[a-z][a-z0-9_]*|\\.features\\.[a-z][a-z0-9_]*(?:\\.(?:rules\\.[a-z][a-z0-9_]*|use_cases\\.[a-z][a-z0-9_]*)|\\.behaviors\\.[a-z][a-z0-9_]*(?:\\.(?:conditions|trigger(?:\\.[a-z][a-z0-9_]*)?|completion|outcome(?:\\.[a-z][a-z0-9_]*)?|failures\\.[a-z][a-z0-9_]*|rules\\.[a-z][a-z0-9_]*))?)?)|architecture\\.[a-z][a-z0-9_]*\\.constraints\\.[a-z][a-z0-9_]*)$"},
    "conditionsObligationPath": {"type": "string", "pattern": "^domains\\.[a-z][a-z0-9_]*\\.features\\.[a-z][a-z0-9_]*\\.behaviors\\.[a-z][a-z0-9_]*\\.conditions$"},
    "triggerObligationPath": {"type": "string", "pattern": "^domains\\.[a-z][a-z0-9_]*\\.features\\.[a-z][a-z0-9_]*\\.behaviors\\.[a-z][a-z0-9_]*\\.trigger(?:\\.[a-z][a-z0-9_]*)?$"},
    "directTriggerObligationPath": {"type": "string", "pattern": "^domains\\.[a-z][a-z0-9_]*\\.features\\.[a-z][a-z0-9_]*\\.behaviors\\.[a-z][a-z0-9_]*\\.trigger$"},
    "alternativeTriggerObligationPath": {"type": "string", "pattern": "^domains\\.[a-z][a-z0-9_]*\\.features\\.[a-z][a-z0-9_]*\\.behaviors\\.[a-z][a-z0-9_]*\\.trigger\\.[a-z][a-z0-9_]*$"},
    "completionObligationPath": {"type": "string", "pattern": "^domains\\.[a-z][a-z0-9_]*\\.features\\.[a-z][a-z0-9_]*\\.behaviors\\.[a-z][a-z0-9_]*\\.completion$"},
    "outcomeObligationPath": {"type": "string", "pattern": "^domains\\.[a-z][a-z0-9_]*\\.features\\.[a-z][a-z0-9_]*\\.behaviors\\.[a-z][a-z0-9_]*\\.outcome(?:\\.[a-z][a-z0-9_]*)?$"},
    "directOutcomeObligationPath": {"type": "string", "pattern": "^domains\\.[a-z][a-z0-9_]*\\.features\\.[a-z][a-z0-9_]*\\.behaviors\\.[a-z][a-z0-9_]*\\.outcome$"},
    "alternativeOutcomeObligationPath": {"type": "string", "pattern": "^domains\\.[a-z][a-z0-9_]*\\.features\\.[a-z][a-z0-9_]*\\.behaviors\\.[a-z][a-z0-9_]*\\.outcome\\.[a-z][a-z0-9_]*$"},
    "failureObligationPath": {"type": "string", "pattern": "^domains\\.[a-z][a-z0-9_]*\\.features\\.[a-z][a-z0-9_]*\\.behaviors\\.[a-z][a-z0-9_]*\\.failures\\.[a-z][a-z0-9_]*$"},
    "ruleObligationPath": {"type": "string", "pattern": "^(?:project|domains\\.[a-z][a-z0-9_]*(?:\\.features\\.[a-z][a-z0-9_]*(?:\\.behaviors\\.[a-z][a-z0-9_]*)?)?)\\.rules\\.[a-z][a-z0-9_]*$"},
    "useCaseObligationPath": {"type": "string", "pattern": "^domains\\.[a-z][a-z0-9_]*\\.features\\.[a-z][a-z0-9_]*\\.use_cases\\.[a-z][a-z0-9_]*$"},
    "architectureConstraintObligationPath": {"type": "string", "pattern": "^architecture\\.[a-z][a-z0-9_]*\\.constraints\\.[a-z][a-z0-9_]*$"},
    "idList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "pathList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/obligationPath"}},
    "project": {"type": "object", "additionalProperties": false, "required": ["id", "name", "purpose", "rule_obligations", "domains"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/text"}, "purpose": {"$ref": "#/$defs/text"}, "rule_obligations": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/ruleObligationPath"}}, "domains": {"type": "array", "minItems": 1, "maxItems": 25, "uniqueItems": true, "items": {"$ref": "#/$defs/domainPath"}}}},
    "vocabulary": {"type": "object", "additionalProperties": false, "required": ["term", "meaning", "forbidden_synonyms"], "properties": {"term": {"$ref": "#/$defs/vocabularyTerm"}, "meaning": {"$ref": "#/$defs/text"}, "forbidden_synonyms": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}},
    "actor": {"type": "object", "additionalProperties": false, "required": ["id", "meaning"], "properties": {"id": {"$ref": "#/$defs/id"}, "meaning": {"$ref": "#/$defs/text"}}},
    "concept": {"type": "object", "additionalProperties": false, "required": ["id", "meaning", "states"], "properties": {"id": {"$ref": "#/$defs/id"}, "meaning": {"$ref": "#/$defs/text"}, "states": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}},
    "architecture": {"type": "object", "additionalProperties": false, "required": ["id", "path", "category", "selection", "rationale", "constraint_obligations", "referenced_by"], "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/architecturePath"}, "category": {"type": "string", "enum": ["database", "framework", "gateway", "provider", "payment_processor", "runtime"]}, "selection": {"$ref": "#/$defs/text"}, "rationale": {"$ref": "#/$defs/text"}, "constraint_obligations": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/architectureConstraintObligationPath"}}, "referenced_by": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/featurePath"}}}},
    "domain": {"type": "object", "additionalProperties": false, "required": ["id", "path", "purpose", "rule_obligations", "features"], "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/domainPath"}, "purpose": {"$ref": "#/$defs/text"}, "rule_obligations": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/ruleObligationPath"}}, "features": {"type": "array", "minItems": 1, "maxItems": 25, "uniqueItems": true, "items": {"$ref": "#/$defs/featurePath"}}}},
    "feature": {"type": "object", "additionalProperties": false, "required": ["id", "path", "domain", "purpose", "actors", "rule_obligations", "use_cases", "behaviors", "related_to", "architecture"], "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/featurePath"}, "domain": {"$ref": "#/$defs/domainPath"}, "purpose": {"$ref": "#/$defs/text"}, "actors": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "rule_obligations": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/ruleObligationPath"}}, "use_cases": {"type": "array", "maxItems": 25, "uniqueItems": true, "items": {"$ref": "#/$defs/useCasePath"}}, "behaviors": {"type": "array", "maxItems": 25, "uniqueItems": true, "items": {"$ref": "#/$defs/behaviorPath"}}, "experience": {"$ref": "#/$defs/experience"}, "related_to": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/productPath"}}, "architecture": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/architecturePath"}}}},
    "experience": {"type": "object", "additionalProperties": false, "required": ["surfaces"], "properties": {"surfaces": {"type": "array", "maxItems": 25, "uniqueItems": true, "items": {"$ref": "#/$defs/surface"}}}},
    "surface": {"type": "object", "additionalProperties": false, "required": ["id", "contains", "states", "accessibility", "responsive_behavior"], "properties": {"id": {"$ref": "#/$defs/id"}, "contains": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "states": {"type": "array", "maxItems": 25, "uniqueItems": true, "items": {"$ref": "#/$defs/surfaceState"}}, "accessibility": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "responsive_behavior": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}},
    "surfaceState": {"type": "object", "additionalProperties": false, "required": ["id", "statements"], "properties": {"id": {"$ref": "#/$defs/id"}, "statements": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}},
    "behavior": {"type": "object", "additionalProperties": false, "required": ["id", "path", "feature", "trigger", "completion_obligation", "outcome", "failures", "rule_obligations", "related_to", "use_cases"], "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/behaviorPath"}, "feature": {"$ref": "#/$defs/featurePath"}, "conditions": {"$ref": "#/$defs/conditions"}, "trigger": {"$ref": "#/$defs/trigger"}, "completion_obligation": {"$ref": "#/$defs/completionObligationPath"}, "outcome": {"$ref": "#/$defs/outcome"}, "failures": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/failure"}}, "rule_obligations": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/ruleObligationPath"}}, "related_to": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/productPath"}}, "use_cases": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/useCasePath"}}}},
    "conditions": {"type": "object", "additionalProperties": false, "required": ["statements", "obligation"], "properties": {"statements": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "obligation": {"$ref": "#/$defs/conditionsObligationPath"}}},
    "trigger": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "case"], "properties": {"kind": {"const": "direct"}, "case": {"$ref": "#/$defs/directTriggerCase"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "cases"], "properties": {"kind": {"const": "one_of"}, "cases": {"type": "array", "minItems": 2, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/triggerAlternative"}}}}]},
    "directTriggerCase": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["obligation", "statement"], "properties": {"obligation": {"$ref": "#/$defs/directTriggerObligationPath"}, "statement": {"$ref": "#/$defs/text"}}}, {"type": "object", "additionalProperties": false, "required": ["obligation", "signal"], "properties": {"obligation": {"$ref": "#/$defs/directTriggerObligationPath"}, "signal": {"$ref": "#/$defs/id"}}}]},
    "triggerAlternative": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["id", "obligation", "statement"], "properties": {"id": {"$ref": "#/$defs/id"}, "obligation": {"$ref": "#/$defs/alternativeTriggerObligationPath"}, "statement": {"$ref": "#/$defs/text"}}}, {"type": "object", "additionalProperties": false, "required": ["id", "obligation", "signal"], "properties": {"id": {"$ref": "#/$defs/id"}, "obligation": {"$ref": "#/$defs/alternativeTriggerObligationPath"}, "signal": {"$ref": "#/$defs/id"}}}]},
    "outcome": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "case"], "properties": {"kind": {"const": "direct"}, "case": {"$ref": "#/$defs/outcomeCase"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "exclusivity_obligation", "cases"], "properties": {"kind": {"const": "one_of"}, "exclusivity_obligation": {"$ref": "#/$defs/directOutcomeObligationPath"}, "cases": {"type": "array", "minItems": 2, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/outcomeAlternative"}}}}]},
    "outcomeCase": {"type": "object", "additionalProperties": false, "required": ["obligation", "statement"], "properties": {"obligation": {"$ref": "#/$defs/directOutcomeObligationPath"}, "statement": {"$ref": "#/$defs/text"}, "signal": {"$ref": "#/$defs/id"}}},
    "outcomeAlternative": {"type": "object", "additionalProperties": false, "required": ["id", "obligation", "statement"], "properties": {"id": {"$ref": "#/$defs/id"}, "obligation": {"$ref": "#/$defs/alternativeOutcomeObligationPath"}, "statement": {"$ref": "#/$defs/text"}, "signal": {"$ref": "#/$defs/id"}}},
    "failure": {"type": "object", "additionalProperties": false, "required": ["id", "obligation", "statement"], "properties": {"id": {"$ref": "#/$defs/id"}, "obligation": {"$ref": "#/$defs/failureObligationPath"}, "statement": {"$ref": "#/$defs/text"}, "signal": {"$ref": "#/$defs/id"}}},
    "useCase": {"type": "object", "additionalProperties": false, "required": ["id", "path", "feature", "actor", "goal", "behaviors", "obligation"], "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/useCasePath"}, "feature": {"$ref": "#/$defs/featurePath"}, "actor": {"$ref": "#/$defs/id"}, "goal": {"$ref": "#/$defs/text"}, "behaviors": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/behaviorPath"}}, "obligation": {"$ref": "#/$defs/useCaseObligationPath"}}},
    "signal": {"type": "object", "additionalProperties": false, "required": ["id", "meaning", "producer", "consumers"], "properties": {"id": {"$ref": "#/$defs/id"}, "meaning": {"$ref": "#/$defs/text"}, "subject": {"$ref": "#/$defs/id"}, "producer": {"$ref": "#/$defs/signalProducer"}, "consumers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/signalConsumer"}}}},
    "signalProducer": {"type": "object", "additionalProperties": false, "required": ["behavior", "completion"], "properties": {"behavior": {"$ref": "#/$defs/behaviorPath"}, "completion": {"anyOf": [{"$ref": "#/$defs/outcomeObligationPath"}, {"$ref": "#/$defs/failureObligationPath"}]}}},
    "signalConsumer": {"type": "object", "additionalProperties": false, "required": ["behavior", "trigger"], "properties": {"behavior": {"$ref": "#/$defs/behaviorPath"}, "trigger": {"$ref": "#/$defs/triggerObligationPath"}}},
    "relationship": {"type": "object", "additionalProperties": false, "required": ["kind", "endpoints", "declared_by"], "properties": {"kind": {"const": "related_to"}, "endpoints": {"type": "array", "prefixItems": [{"$ref": "#/$defs/productPath"}, {"$ref": "#/$defs/productPath"}], "items": false, "minItems": 2, "maxItems": 2, "uniqueItems": true}, "declared_by": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/productPath"}}}},
    "useCaseMembership": {"type": "object", "additionalProperties": false, "required": ["use_case", "behavior"], "properties": {"use_case": {"$ref": "#/$defs/useCasePath"}, "behavior": {"$ref": "#/$defs/behaviorPath"}}},
    "obligation": {"oneOf": [{"$ref": "#/$defs/conditionsObligation"}, {"$ref": "#/$defs/triggerObligation"}, {"$ref": "#/$defs/completionObligation"}, {"$ref": "#/$defs/exclusivityObligation"}, {"$ref": "#/$defs/outcomeObligation"}, {"$ref": "#/$defs/failureObligation"}, {"$ref": "#/$defs/ruleObligation"}, {"$ref": "#/$defs/useCaseObligation"}, {"$ref": "#/$defs/architectureConstraintObligation"}]},
    "obligationBase": {"type": "object", "additionalProperties": false, "required": ["id", "node", "kind", "definition"], "properties": {"id": {"$ref": "#/$defs/obligationPath"}, "node": {"$ref": "#/$defs/obligationNode"}, "kind": {"type": "string"}, "definition": {"type": "object"}}},
    "conditionsObligation": {"allOf": [{"$ref": "#/$defs/obligationBase"}, {"properties": {"id": {"$ref": "#/$defs/conditionsObligationPath"}, "node": {"$ref": "#/$defs/behaviorPath"}, "kind": {"const": "conditions"}, "definition": {"type": "object", "additionalProperties": false, "required": ["statements"], "properties": {"statements": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}}}}]},
    "triggerObligation": {"allOf": [{"$ref": "#/$defs/obligationBase"}, {"properties": {"id": {"$ref": "#/$defs/triggerObligationPath"}, "node": {"$ref": "#/$defs/behaviorPath"}, "kind": {"const": "trigger"}, "definition": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["statement"], "properties": {"statement": {"$ref": "#/$defs/text"}}}, {"type": "object", "additionalProperties": false, "required": ["signal"], "properties": {"signal": {"$ref": "#/$defs/id"}}}]}}}]},
    "completionObligation": {"allOf": [{"$ref": "#/$defs/obligationBase"}, {"properties": {"id": {"$ref": "#/$defs/completionObligationPath"}, "node": {"$ref": "#/$defs/behaviorPath"}, "kind": {"const": "completion"}, "definition": {"type": "object", "additionalProperties": false, "required": ["outcomes", "failures"], "properties": {"outcomes": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/outcomeObligationPath"}}, "failures": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/failureObligationPath"}}}}}}]},
    "exclusivityObligation": {"allOf": [{"$ref": "#/$defs/obligationBase"}, {"properties": {"id": {"$ref": "#/$defs/outcomeObligationPath"}, "node": {"$ref": "#/$defs/behaviorPath"}, "kind": {"const": "outcome_exclusivity"}, "definition": {"type": "object", "additionalProperties": false, "required": ["alternatives"], "properties": {"alternatives": {"type": "array", "minItems": 2, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/outcomeObligationPath"}}}}}}]},
    "outcomeObligation": {"allOf": [{"$ref": "#/$defs/obligationBase"}, {"properties": {"id": {"$ref": "#/$defs/outcomeObligationPath"}, "node": {"$ref": "#/$defs/behaviorPath"}, "kind": {"const": "outcome"}, "definition": {"$ref": "#/$defs/completionDefinition"}}}]},
    "failureObligation": {"allOf": [{"$ref": "#/$defs/obligationBase"}, {"properties": {"id": {"$ref": "#/$defs/failureObligationPath"}, "node": {"$ref": "#/$defs/behaviorPath"}, "kind": {"const": "failure"}, "definition": {"$ref": "#/$defs/completionDefinition"}}}]},
    "completionDefinition": {"type": "object", "additionalProperties": false, "required": ["statement"], "properties": {"statement": {"$ref": "#/$defs/text"}, "signal": {"$ref": "#/$defs/id"}}},
    "ruleObligation": {"allOf": [{"$ref": "#/$defs/obligationBase"}, {"properties": {"id": {"$ref": "#/$defs/ruleObligationPath"}, "node": {"anyOf": [{"const": "project"}, {"$ref": "#/$defs/domainPath"}, {"$ref": "#/$defs/featurePath"}, {"$ref": "#/$defs/behaviorPath"}]}, "kind": {"const": "rule"}, "definition": {"type": "object", "additionalProperties": false, "required": ["statement"], "properties": {"statement": {"$ref": "#/$defs/text"}}}}}]},
    "useCaseObligation": {"allOf": [{"$ref": "#/$defs/obligationBase"}, {"properties": {"id": {"$ref": "#/$defs/useCaseObligationPath"}, "node": {"$ref": "#/$defs/featurePath"}, "kind": {"const": "use_case"}, "definition": {"type": "object", "additionalProperties": false, "required": ["actor", "goal", "behaviors"], "properties": {"actor": {"$ref": "#/$defs/id"}, "goal": {"$ref": "#/$defs/text"}, "behaviors": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/behaviorPath"}}}}}}]},
    "architectureConstraintObligation": {"allOf": [{"$ref": "#/$defs/obligationBase"}, {"properties": {"id": {"$ref": "#/$defs/architectureConstraintObligationPath"}, "node": {"$ref": "#/$defs/architecturePath"}, "kind": {"const": "architecture_constraint"}, "definition": {"type": "object", "additionalProperties": false, "required": ["statement"], "properties": {"statement": {"$ref": "#/$defs/text"}}}}}]}
  }
}
